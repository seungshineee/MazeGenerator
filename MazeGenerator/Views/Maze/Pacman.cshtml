@model PacmanViewModel
@{
    ViewData["Title"] = "Pac-Man";
    var best = Model.BestTime?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
}

<style>
    .game {
        --bg: #f5f5f7;
        --card: #ffffff;
        --text: #1d1d1f;
        --muted: #6e6e73;
        --accent: #6366f1;
        --border: #d8d8de;

        max-width: 960px;
        margin: 0 auto;
        padding: 32px 16px 60px;
        color: var(--text);
    }

    .game-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }
    .game-head h1 { margin: 0; font-size: 1.6rem; }

    .stats { display: flex; gap: 12px; flex-wrap: wrap; }
    .stat {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 8px 16px;
        text-align: center;
        min-width: 90px;
    }
    .stat-label { display: block; font-size: 0.8rem; color: var(--muted); }
    .stat-value { font-size: 1.3rem; font-weight: 700; }
    .lives { color: #ef4444; letter-spacing: 2px; }

    .canvas-wrap {
        position: relative;
        margin: 20px 0;
        display: flex;
        justify-content: center;
    }
    #maze {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        max-width: 100%;
    }

    .overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.45);
        border-radius: 8px;
    }
    .overlay[hidden] { display: none; }
    .overlay-box {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 24px 32px;
        text-align: center;
        max-width: 320px;
    }
    .overlay-box h2 { margin-top: 0; }

    .btn-fill, .btn-outline {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 8px;
        font: inherit;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
    }
    .btn-fill {
        background: var(--accent);
        color: #fff;
        border: 1px solid var(--accent);
        margin-top: 8px;
    }
    .btn-outline {
        background: var(--card);
        color: var(--text);
        border: 1px solid var(--border);
    }
    .btn-outline:hover { border-color: var(--accent); }

    .game-actions { display: flex; gap: 12px; justify-content: center; }

    .dpad {
        display: grid;
        grid-template-columns: repeat(3, 56px);
        grid-template-areas: ". up ." "left . right" ". down .";
        gap: 6px;
        justify-content: center;
        margin: 20px 0 0;
    }
    .dpad button {
        height: 56px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--card);
        color: var(--text);
        font-size: 1.2rem;
        cursor: pointer;
    }
    .dpad button:active { background: var(--accent); color: #fff; }
    .dpad-up { grid-area: up; }
    .dpad-left { grid-area: left; }
    .dpad-right { grid-area: right; }
    .dpad-down { grid-area: down; }

    .hint { text-align: center; color: var(--muted); font-size: 0.9rem; }

    .pause-hint {
        position: absolute;
        left: 50%;
        top: 12px;
        transform: translateX(-50%);
        padding: 8px 16px;
        background: rgba(0, 0, 0, 0.7);
        color: #fff;
        border-radius: 999px;
        font-size: 0.9rem;
        pointer-events: none;
        z-index: 2;
    }

    .pause-hint[hidden] {
        display: none;
    }

    @@media (hover: hover) and (pointer: fine) {
        .dpad { display: none; }
    }
</style>

<div class="game" id="game">
    <div class="game-head">
        <h1>Pac-Man</h1>
        <div class="stats">
            <div class="stat">
                <span class="stat-label">Жизни</span>
                <span id="lives" class="stat-value lives">♥♥♥</span>
            </div>
            <div class="stat">
                <span class="stat-label">Предметы</span>
                <span id="items" class="stat-value">0 / 5</span>
            </div>
            <div class="stat">
                <span class="stat-label">Время</span>
                <span id="time" class="stat-value">0.0</span>
            </div>
            <div class="stat">
                <span class="stat-label">Рекорд</span>
                <span id="best" class="stat-value" data-best="@best">—</span>
            </div>
        </div>
    </div>

    <div class="canvas-wrap">
        <div id="pause-hint" class="pause-hint">Нажми стрелку, чтобы начать</div>
        <canvas id="maze"></canvas>
        <div id="message" class="overlay" hidden>
            <div class="overlay-box">
                <h2 id="message-title">Готово!</h2>
                <p id="message-text"></p>
                <button id="again" class="btn-fill" type="button">Играть снова</button>
            </div>
        </div>
    </div>

    <div class="game-actions">
        <button id="restart" class="btn-outline" type="button">Новая карта</button>
        <a class="btn-outline" asp-controller="Home" asp-action="Index">К выбору режима</a>
    </div>

    <div class="dpad">
        <button type="button" data-dx="0" data-dy="-1" class="dpad-up">▲</button>
        <button type="button" data-dx="-1" data-dy="0" class="dpad-left">◀</button>
        <button type="button" data-dx="1" data-dy="0" class="dpad-right">▶</button>
        <button type="button" data-dx="0" data-dy="1" class="dpad-down">▼</button>
    </div>

    <p class="hint">Стрелки или WASD. Собери все 5 предметов и не попадись врагам: у тебя 3 жизни. Враги начинают двигаться после твоего первого шага.</p>
</div>

@section Scripts {
    <script>
        (function () {
            const generateUrl = '@Url.Action("GeneratePacman", "Maze")';
            const saveUrl = '@Url.Action("SaveResult", "Maze")';
            const imgSrc = '@Model.CharacterImage';

            // настройки игры
            const TOTAL_LIVES = 3;
            const TOTAL_ITEMS = 5;
            const ENEMY_STEP_MS = 450;   // чем меньше, тем быстрее враги
            const CHASE = 0.7;           // вероятность, что враг идёт к игроку (иначе бродит случайно)
            const INVULN_MS = 1500;      // неуязвимость после потери жизни

            const gameEl = document.getElementById('game');
            const canvas = document.getElementById('maze');
            const ctx = canvas.getContext('2d');
            const timeEl = document.getElementById('time');
            const bestEl = document.getElementById('best');
            const livesEl = document.getElementById('lives');
            const itemsEl = document.getElementById('items');
            const messageEl = document.getElementById('message');
            const messageTitle = document.getElementById('message-title');
            const messageText = document.getElementById('message-text');

            const pauseHint = document.getElementById('pause-hint');

            const PAD = 4;
            let best = parseFloat(bestEl.dataset.best);
            if (isNaN(best)) best = null;
            showBest();

            function loadImg(src) {
                const im = new Image();
                im.ok = false;
                im.onload = function () { im.ok = true; };
                im.src = src;
                return im;
            }
            const playerImg = loadImg(imgSrc);

            let maze = null, cell = 0, px = 0, py = 0;
            let items = [], enemies = [];
            let lives = TOTAL_LIVES, collected = 0;
            let timerId = null, enemyId = null;
            let running = false, runStart = 0, elapsedMs = 0;
            let finished = false, invulnUntil = 0;

            function showBest() {
                bestEl.textContent = best === null ? '—' : best.toFixed(1) + ' с';
            }

            function updateHud() {
                livesEl.textContent = '♥'.repeat(lives) + '♡'.repeat(TOTAL_LIVES - lives);
                itemsEl.textContent = collected + ' / ' + TOTAL_ITEMS;
            }

            function css(name, fallback) {
                const v = getComputedStyle(gameEl).getPropertyValue(name).trim();
                return v || fallback;
            }

            function stopAll() {
                if (timerId !== null) { clearInterval(timerId); timerId = null; }
                if (enemyId !== null) { clearInterval(enemyId); enemyId = null; }
            }

            function showPause(text) {
                pauseHint.textContent = text;
                pauseHint.hidden = false;
            }

            function hidePause() {
                pauseHint.hidden = true;
            }

            // сколько секунд игра шла (без пауз)
            function totalSeconds() {
                return (elapsedMs + (running ? performance.now() - runStart : 0)) / 1000;
            }

            function pauseRun() {
                if (!running) return;
                elapsedMs += performance.now() - runStart;
                running = false;
                stopAll();
            }

            function fit() {
                if (!maze) return;
                const maxSize = Math.max(320, Math.min(900, canvas.parentElement.clientWidth, window.innerHeight - 200));
                cell = Math.floor((maxSize - PAD * 2) / Math.max(maze.width, maze.height));
                canvas.width = cell * maze.width + PAD * 2;
                canvas.height = cell * maze.height + PAD * 2;
            }

            async function load() {
                stopAll();
                finished = false;
                running = false;
                elapsedMs = 0;
                lives = TOTAL_LIVES;
                collected = 0;
                invulnUntil = 0;
                timeEl.textContent = '0.0';
                messageEl.hidden = true;
                showPause('Нажми стрелку, чтобы начать');
                updateHud();

                const res = await fetch(generateUrl, { cache: 'no-store' });
                const data = await res.json();

                px = 0;
                py = 0;
                items = data.items.map(function (i) { return { x: i.x, y: i.y, got: false }; });
                enemies = data.enemies.map(function (e) { return { x: e.x, y: e.y, img: loadImg(e.image) }; });
                maze = data;
                fit();
            }

            // ---------- отрисовка ----------

            function drawSprite(img, x, y, fallbackColor) {
                const m = Math.max(2, cell * 0.04);
                const ox = PAD + x * cell + m, oy = PAD + y * cell + m, size = cell - m * 2;
                if (img && img.ok) {
                    const k = Math.min(size / img.width, size / img.height);
                    const w = img.width * k, h = img.height * k;
                    ctx.drawImage(img, ox + (size - w) / 2, oy + (size - h) / 2, w, h);
                } 
                else {
                    ctx.fillStyle = fallbackColor;
                    ctx.beginPath();
                    ctx.arc(ox + size / 2, oy + size / 2, size / 2, 0, Math.PI * 2);
                    ctx.fill();
                }
            }

            function draw() {
                if (!maze) return;

                ctx.fillStyle = css('--bg', '#f5f5f7');
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                // стены
                ctx.strokeStyle = css('--text', '#1d1d1f');
                ctx.lineWidth = 3;
                ctx.lineCap = 'round';
                ctx.beginPath();
                for (let y = 0; y < maze.height; y++) {
                    for (let x = 0; x < maze.width; x++) {
                        const c = maze.cells[y * maze.width + x];
                        const x0 = PAD + x * cell, y0 = PAD + y * cell;
                        const x1 = x0 + cell, y1 = y0 + cell;
                        if (c.top)    { ctx.moveTo(x0, y0); ctx.lineTo(x1, y0); }
                        if (c.right)  { ctx.moveTo(x1, y0); ctx.lineTo(x1, y1); }
                        if (c.bottom) { ctx.moveTo(x0, y1); ctx.lineTo(x1, y1); }
                        if (c.left)   { ctx.moveTo(x0, y0); ctx.lineTo(x0, y1); }
                    }
                }
                ctx.stroke();

                // предметы
                items.forEach(function (it) {
                    if (it.got) return;
                    ctx.fillStyle = '#f59e0b';
                    ctx.strokeStyle = '#b45309';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.arc(PAD + it.x * cell + cell / 2, PAD + it.y * cell + cell / 2, cell * 0.28, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.stroke();
                });

                // враги
                enemies.forEach(function (e) { drawSprite(e.img, e.x, e.y, '#ef4444'); });

                // игрок (мигает после потери жизни)
                const now = performance.now();
                const blink = now < invulnUntil && Math.floor(now / 150) % 2 === 0;
                ctx.globalAlpha = blink ? 0.35 : 1;
                drawSprite(playerImg, px, py, css('--accent', '#6366f1'));
                ctx.globalAlpha = 1;
            }

            function loop() {
                draw();
                requestAnimationFrame(loop);
            }

            // ---------- движение игрока ----------

            function move(dx, dy) {
                if (!maze || finished) return;
                const c = maze.cells[py * maze.width + px];
                if (dx === 1 && c.right) return;
                if (dx === -1 && c.left) return;
                if (dy === -1 && c.top) return;
                if (dy === 1 && c.bottom) return;

                px += dx;
                py += dy;
                if (!running) startRun();

                pickUp();
                checkHit();
            }

            function startRun() {
                if (running) return;
                running = true;
                runStart = performance.now();
                hidePause();

                // после потери жизни неуязвимость отсчитывается с первого шага
                if (invulnUntil === Infinity) invulnUntil = runStart + INVULN_MS;

                timerId = setInterval(function () {
                    timeEl.textContent = totalSeconds().toFixed(1);
                }, 100);
                enemyId = setInterval(moveEnemies, ENEMY_STEP_MS);
            }

            function pickUp() {
                items.forEach(function (it) {
                    if (!it.got && it.x === px && it.y === py) {
                        it.got = true;
                        collected++;
                        updateHud();
                    }
                });
                if (collected === TOTAL_ITEMS) win();
            }

            function checkHit() {
                if (finished) return;
                const now = performance.now();
                if (now < invulnUntil) return;

                const hit = enemies.some(function (e) { return e.x === px && e.y === py; });
                if (!hit) return;

                lives--;
                updateHud();
                if (lives <= 0) {
                    lose();
                    return;
                }

                // потеряна жизнь: пауза, игрок на старте, ждём первого шага
                pauseRun();
                px = 0;
                py = 0;
                invulnUntil = Infinity;
                showPause('Потеряна жизнь. Нажми стрелку, чтобы продолжить');
            }

            // ---------- враги ----------

            function neighbors(x, y) {
                const c = maze.cells[y * maze.width + x];
                const r = [];
                if (!c.top)    r.push([x, y - 1]);
                if (!c.right)  r.push([x + 1, y]);
                if (!c.bottom) r.push([x, y + 1]);
                if (!c.left)   r.push([x - 1, y]);
                return r;
            }

            // шаг врага по кратчайшему пути к игроку (поиск в ширину)
            function stepToward(e) {
                const w = maze.width;
                const start = e.y * w + e.x, goal = py * w + px;
                if (start === goal) return;

                const prev = new Array(w * maze.height).fill(-1);
                prev[start] = start;
                const queue = [start];

                while (queue.length) {
                    const cur = queue.shift();
                    if (cur === goal) break;
                    const cx = cur % w, cy = Math.floor(cur / w);
                    neighbors(cx, cy).forEach(function (n) {
                        const ni = n[1] * w + n[0];
                        if (prev[ni] === -1) { prev[ni] = cur; queue.push(ni); }
                    });
                }

                if (prev[goal] === -1) return;
                let cur = goal;
                while (prev[cur] !== start) cur = prev[cur];
                e.x = cur % w;
                e.y = Math.floor(cur / w);
            }

            function stepRandom(e) {
                const options = neighbors(e.x, e.y);
                const n = options[Math.floor(Math.random() * options.length)];
                e.x = n[0];
                e.y = n[1];
            }

            function moveEnemies() {
                if (finished) return;
                enemies.forEach(function (e) {
                    if (Math.random() < CHASE) stepToward(e); else stepRandom(e);
                });
                checkHit();
            }

            // ---------- конец игры ----------

            function lose() {
                finished = true;
                pauseRun();
                hidePause();
                messageTitle.textContent = 'Жизни закончились';
                messageText.textContent = 'Собрано предметов: ' + collected + ' из ' + TOTAL_ITEMS + '.';
                messageEl.hidden = false;
            }

            async function win() {
                finished = true;
                const elapsed = totalSeconds();
                pauseRun();
                hidePause();
                timeEl.textContent = elapsed.toFixed(1);
                messageTitle.textContent = 'Победа!';
                messageText.textContent = 'Время: ' + elapsed.toFixed(1) + ' с. Жизней осталось: ' + lives + '.';
                messageEl.hidden = false;

                try {
                    const res = await fetch(saveUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ difficulty: 'Easy', timeSeconds: elapsed, mazeType: 'Pacman' })
                    });

                    if (res.status === 401) {
                        messageText.textContent += ' Войди в аккаунт, чтобы результаты сохранялись.';
                        return;
                    }
                    if (res.ok) {
                        const data = await res.json();
                        const isRecord = best === null || elapsed < best;
                        best = data.bestTime;
                        showBest();
                        if (isRecord) messageText.textContent += ' Новый рекорд!';
                    }
                } catch (e) {
                    messageText.textContent += ' Не удалось сохранить результат.';
                }
            }

            // ---------- управление ----------

            document.addEventListener('keydown', function (e) {
                const keys = {
                    ArrowUp: [0, -1], w: [0, -1], W: [0, -1],
                    ArrowDown: [0, 1], s: [0, 1], S: [0, 1],
                    ArrowLeft: [-1, 0], a: [-1, 0], A: [-1, 0],
                    ArrowRight: [1, 0], d: [1, 0], D: [1, 0]
                };
                const dir = keys[e.key];
                if (dir) {
                    e.preventDefault();
                    move(dir[0], dir[1]);
                }
            });

            document.querySelectorAll('.dpad button').forEach(function (b) {
                b.addEventListener('click', function () {
                    move(parseInt(b.dataset.dx), parseInt(b.dataset.dy));
                });
            });

            document.getElementById('restart').addEventListener('click', load);
            document.getElementById('again').addEventListener('click', load);

            window.addEventListener('resize', fit);
            load();
            requestAnimationFrame(loop);
        })();
    </script>
}