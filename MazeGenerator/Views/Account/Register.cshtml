@model RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
}

<style>
    .auth {
        --bg: #f5f5f7;
        --card: #ffffff;
        --text: #1d1d1f;
        --muted: #6e6e73;
        --accent: #133214;
        --border: #d8d8de;
        --error: #d93025;

        max-width: 360px;
        margin: 60px auto;
        padding: 28px;
        background: var(--card);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 12px;
    }

    .auth h1 {
        margin: 0 0 20px;
        font-size: 1.5rem;
        text-align: center;
    }

    .auth label {
        display: block;
        margin: 14px 0 4px;
        font-size: 0.9rem;
        color: var(--muted);
    }

    .auth input {
        box-sizing: border-box;
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        color: var(--text);
        font: inherit;
    }
    .auth input:focus {
        outline: none;
        border-color: var(--accent);
    }

    .auth .error {
        display: block;
        margin-top: 4px;
        color: var(--error);
        font-size: 0.85rem;
    }

    .auth .btn {
        width: 100%;
        margin-top: 22px;
        padding: 10px;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 8px;
        font: inherit;
        font-weight: 500;
        cursor: pointer;
    }
    .auth .btn:hover { opacity: 0.9; }

    .auth p {
        margin: 18px 0 0;
        text-align: center;
        font-size: 0.9rem;
        color: var(--muted);
    }
    .auth a { color: var(--accent); text-decoration: none; }
    .auth a:hover { text-decoration: underline; }
</style>

<div class="auth">
    <h1>Регистрация</h1>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="error"></div>

        <label asp-for="Username">Логин</label>
        <input asp-for="Username" autocomplete="username" />
        <span asp-validation-for="Username" class="error"></span>

        <label asp-for="Password">Пароль</label>
        <input asp-for="Password" autocomplete="new-password" />
        <span asp-validation-for="Password" class="error"></span>

        <label asp-for="ConfirmPassword">Повторите пароль</label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="error"></span>

        <button type="submit" class="btn">Зарегистрироваться</button>
    </form>
    <p>Уже есть аккаунт? <a asp-action="Login">Войти</a></p>
</div>